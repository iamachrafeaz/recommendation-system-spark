# Configuration du système de recommandation
# Voir QUICKSTART.md pour l'utilisation

# ==========================================
# KAFKA
# ==========================================
KAFKA_TOPIC=product_reviews
KAFKA_BOOTSTRAP_SERVERS=broker:9092
KAFKA_NUM_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1

# ==========================================
# REDIS
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=  # Laisser vide si pas d'authentification
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# ==========================================
# SPARK
# ==========================================
SPARK_MASTER=spark://spark-master:7077
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_EXECUTOR_CORES=2
SPARK_DEFAULT_PARALLELISM=8

# ==========================================
# SPARK BATCH (ALS Training)
# ==========================================
BATCH_INPUT_PATH=/app/reviews_90.csv
BATCH_OUTPUT_DIR=/app/output
BATCH_TRAIN_RATIO=0.8
BATCH_ALS_RANK=10
BATCH_ALS_ITERATIONS=10
BATCH_ALS_REG_PARAM=0.1
BATCH_SEED=42

# ==========================================
# SPARK STREAMING
# ==========================================
STREAMING_KAFKA_STARTING_OFFSETS=latest
STREAMING_CHECKPOINT_DIR=/tmp/checkpoints/als_streaming_to_redis
STREAMING_TRIGGER_INTERVAL=10000  # ms
STREAMING_TIMEOUT=600  # secondes

# ==========================================
# AIRFLOW
# ==========================================
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow

# Utilisateurs Airflow
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ==========================================
# DASHBOARD API (Flask)
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_WORKERS=4

# ==========================================
# DASHBOARD UI (Streamlit)
# ==========================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_LOGGER_LEVEL=info
API_BASE_URL=http://dashboard-api:8000

# ==========================================
# POSTGRES (Airflow Backend)
# ==========================================
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s [%(levelname)s] %(name)s - %(message)s

# ==========================================
# TIMEOUTS (secondes)
# ==========================================
KAFKA_CONNECTION_TIMEOUT=30
REDIS_CONNECTION_TIMEOUT=10
SPARK_JOB_TIMEOUT=1800  # 30 minutes
API_REQUEST_TIMEOUT=30

# ==========================================
# PERSISTENCE
# ==========================================
REDIS_PERSISTENCE=yes
REDIS_RDB_INTERVAL=3600  # Save every hour
POSTGRES_BACKUP_INTERVAL=86400  # Every day

